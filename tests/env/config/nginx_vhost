# add server-side port and http `Host` header to the access log, to help with troubleshooting
log_format extended '$remote_addr - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent" $server_port "$http_host"';

# @todo should we split the access log file in many separate ones?
#       A single log file is nice to see the timing/interleaving of client requests to the waf with waf requests to the server.
#       Otoh it makes it slightly harder to tell apart requests received on the various ports/sockets...

# enable compression for application/json and other common response types we might produce (similar to Apache stock config)
gzip_types text/plain text/css application/json application/php-serialized+base64 application/javascript text/xml application/xml application/xml+rss text/javascript;
gzip_vary on;

# HTTP

# Upstream server
server {

    set $tests_root_dir /var/www/tests/public;
    # eg: '127.0.0.1:9000' or 'unix:/run/php/php8.5-fpm.sock'
    set $php_fpm_socket unix:/run/php/php8.5-fpm.sock;

    listen 80 default_server;
    listen [::]:80 default_server;

    fastcgi_buffering off;

    access_log /var/log/nginx/access.log extended;
    error_log /var/log/nginx/error.log info;

    root $tests_root_dir;

    index index.php;

    # try to avoid mixing up access to the waf and the server
    location /waf.php {
        return 418 "I'm an upstream server";
    }

    location / {
            # First attempt to serve request as file, then
            # as directory, then fall back to displaying a 404.
            try_files $uri $uri/ =404;
    }

    # pass PHP scripts to FastCGI server
    # NB: the stock php-fpm config for apache also serves .phar and .phtml files. And it prevents files named `.php`
    #     We replicate it here
    location ~ [^/]+\.ph(?:p|ar|html)$ {
           include snippets/fastcgi-php.conf;

           # With php-fpm (or other unix sockets):
           fastcgi_pass $php_fpm_socket;
           # With php-cgi (or other tcp sockets):
           #fastcgi_pass 127.0.0.1:9000;
    }

    # deny access to .htaccess files, if Apache's document root
    # concurs with nginx's one
    #
    location ~ /\.ht {
           deny all;
    }
}

