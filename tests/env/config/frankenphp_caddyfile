# https://frankenphp.dev/docs/config
# https://caddyserver.com/docs/caddyfile

{
    skip_install_trust
    auto_https off

    # `persist_config on` is needed to persist changes made via the API - which we do not allow for the moment
    persist_config off

    frankenphp {
        # nb: keep in sync with php.append.ini

        php_ini display_errors On
        php_ini display_startup_errors On
        php_ini enable_dl Off
        php_ini expose_php On
        php_ini file_uploads On
        php_ini include_path .
        php_ini log_errors On
        php_ini short_open_tag Off

        php_ini error_level -1
        php_ini max_execution_time 15
        php_ini output_buffering Off

        # set to a high number as we have tests making multiple concurrent requests (while workers are kept busy on slow responses)
        #nb: max_threads defaults to 2 x num_threads
        num_threads 15
    }

    log {
        output stdout
        # set to `error` for load testing
        level info
        format console
    }
}

# Upstream server
# allow running unprivileged: instead of 82, go for 1082
# @todo test if setcap works now that we set it up, and move back to port 82.
#       Remember to change .env.frankenphp, Dockerfile and container.sh too
:1082 {
    root /var/www/tests/public

    encode zstd br gzip

    log

    # Allow the waf to make requests that will result in a 404 - do not funnel all of them into server.php
    #rewrite * /server.php

    # try to avoid mixing up access to the waf and the server
    respond /waf.php 418

    php_server {
        # for worker mode (eg. for load tests), use
        #worker /var/www/tests/public/loadtest/loadtest_frankenphp.php { # or noop_frankenphp.php
        #    match *
        #}
        # further optimizations:
        #file_server off
    }
}

# WAF
:8082 {
    root /var/www/tests/public

    encode zstd br gzip

    log

    rewrite * /waf.php

    php_server
}

# Upstream server
:1082 {
    bind unix//run/frankenphp/caddy.server.sock|0222

    root /var/www/tests/public

    encode zstd br gzip

    log

    #rewrite * /server.php

    # try to avoid mixing up access to the waf and the server
    respond /waf.php 418

    php_server
}

# WAF
:8082 {
    bind unix//run/frankenphp/caddy.waf.sock|0222

    root /var/www/tests/public

    encode zstd br gzip

    log

    rewrite * /waf.php

    php_server
}

